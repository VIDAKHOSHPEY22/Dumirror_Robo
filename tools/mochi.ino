// Show a bitmap frame on the OLED display
void showFrame(const uint8_t* frame) {
  display.clearDisplay();
  display.drawBitmap(0, 0, frame, 128, 64, WHITE);
  display.display();
}

void setup() {
  Serial.begin(115200);
  Wire.begin(8, 9); // SDA=8, SCL=9

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    Serial.println("OLED not found");
    while (true);
  }

  display.clearDisplay();
  display.display();
}

void loop() {
  showFrame(face1);
  delay(500);

  showFrame(face2);
  delay(500);

  showFrame(face3);
  delay(500);

  showFrame(face4);
  delay(500);
}